<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron necesita estos dos para JIT de V8 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    Videollamadas. Con `hardenedRuntime: true` los textos de uso del Info.plist NO bastan:
    sin estos entitlements, cámara y micrófono quedan bloqueados en el build firmado aunque
    funcionen perfectamente en desarrollo, donde no se aplica el runtime endurecido.

    Compartir pantalla NO necesita entitlement: es solo TCC (Ajustes → Privacidad →
    Grabación de pantalla). Ver src/main/screenshare.ts.
  -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!--
    Passkeys (WebAuthn con Touch ID / Secure Enclave).
    Debe coincidir EXACTAMENTE con el keychainAccessGroup que pasamos a
    session.configureWebAuthn() en src/main/index.ts:
        <TEAM_ID>.com.monper.app.webauthn
    Reemplaza $(AppIdentifierPrefix) o escribe tu Team ID literal.
  -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.monper.app.webauthn</string>
  </array>
</dict>
</plist>
