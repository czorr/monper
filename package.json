{
  "name": "titanio",
  "productName": "Titanio Browser",
  "version": "0.2.0",
  "description": "Titanio — un navegador agéntico de escritorio",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm build:mcp",
    "start": "electron-vite preview",
    "typecheck": "rm -f *.tsbuildinfo && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "test": "pnpm build && playwright test",
    "test:only": "playwright test",
    "test:ai-config": "node --test tests/ai-config.node.mjs",
    "test:chats": "node --test tests/chats.node.mjs",
    "test:profiles": "node --test tests/profiles.node.mjs",
    "build:mcp": "tsc -p packages/titanio-mcp/tsconfig.json && chmod +x packages/titanio-mcp/dist/index.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-json/simple-icons": "^1.2.91",
    "@iconify-json/tabler": "^1.2.37",
    "@playwright/test": "^1.62.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.18",
    "@fontsource-variable/geist": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@ghostery/adblocker-electron-preload": "^2.18.1",
    "@mastra/core": "^1.52.0",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.1.1",
    "zod": "^4.4.3"
  }
}
